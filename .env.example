# Copy to .env and replace every placeholder before starting the stack.
#
# .env is git-ignored and must never be committed (V3 §21). The values below are placeholders,
# not credentials: nothing here is a working secret, and none of them may be used as-is outside a
# throwaway local environment.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
JWT_SECRET=replace-me-min-32-chars-required-000000
JWT_TTL_SECONDS=1800

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=c17
POSTGRES_PASSWORD=replace-me-local-only
POSTGRES_DB=c17
POSTGRES_PORT=5432

# One database per owning service (V3 §7). Each service reads only its own.
AUTH_DATABASE_URL=postgresql://c17:replace-me-local-only@localhost:5432/auth_db
USER_ROLE_DATABASE_URL=postgresql://c17:replace-me-local-only@localhost:5432/user_role_db
TASK_DATABASE_URL=postgresql://c17:replace-me-local-only@localhost:5432/task_db
DOCUMENT_DATABASE_URL=postgresql://c17:replace-me-local-only@localhost:5432/document_db
DOCUMENT_SECURITY_DATABASE_URL=postgresql://c17:replace-me-local-only@localhost:5432/document_security_db
PERMISSION_DATABASE_URL=postgresql://c17:replace-me-local-only@localhost:5432/permission_db
AUDIT_DATABASE_URL=postgresql://c17:replace-me-local-only@localhost:5432/audit_db
NOTIFICATION_DATABASE_URL=postgresql://c17:replace-me-local-only@localhost:5432/notification_db
SECURITY_MONITORING_DATABASE_URL=postgresql://c17:replace-me-local-only@localhost:5432/security_monitoring_db

# --- Redis -----------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- RabbitMQ --------------------------------------------------------------
RABBITMQ_USER=c17
RABBITMQ_PASSWORD=replace-me-local-only
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://c17:replace-me-local-only@localhost:5672

# --- MinIO -----------------------------------------------------------------
MINIO_ACCESS_KEY=replace-me-local-only
MINIO_SECRET_KEY=replace-me-local-only
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_BUCKET=documents

# --- ClamAV ----------------------------------------------------------------
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000

# --- Document Security -----------------------------------------------------
DOCUMENT_ACTIVE_KEK_VERSION=1
DOCUMENT_KEK_V1=replace-me-local-only
DOCUMENT_SIGNATURE_KEY=replace-me-local-only

# --- Service URLs (used by api-gateway and inter-service calls) ---------------
PERMISSION_SERVICE_URL=http://localhost:3006
AUDIT_SERVICE_URL=http://localhost:3007
PERMISSION_CHECK_TIMEOUT_MS=2000
AUDIT_TIMEOUT_MS=2000
SECURITY_TIMEOUT_MS=5000

# --- E2E testing ------------------------------------------------------------
# E2E_POSTGRES_BASE_URL=postgresql://c17:replace-me-local-only@localhost:5433

# --- Outbound email (SMTP) -----------------------------------------------------
# Gmail / Google Workspace: enable 2-Step Verification, then create an "App password".
# MAIL_USER is the full account address; MAIL_PASS is the app password (never the login password).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=replace-me@gmail.com
MAIL_PASS=replace-me-app-password
MAIL_FROM=replace-me@gmail.com

# Public base URL used in email CTA buttons (deadline reminders, security alerts).
WEB_BASE_URL=http://localhost

# --- Email verification (OTP) ---------------------------------------------------
OTP_TTL_SECONDS=600
OTP_RESEND_SECONDS=60

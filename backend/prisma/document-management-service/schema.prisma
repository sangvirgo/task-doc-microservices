generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@prisma/client-document"
}

datasource db {
  provider = "postgresql"
  url      = env("DOCUMENT_DATABASE_URL")
}

model Document {
  id               String    @id @default(uuid())
  title            String
  document_type    String
  owner_id         String
  creator_id       String
  security_level   String    @default("INTERNAL")
  status           String    @default("UPLOADED")
  current_version  Int       @default(1)
  retention_policy String?
  retention_expires_at DateTime?
  archive_status   String?
  disposal_status  String?
  record_id        String?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  versions DocumentVersion[]
  outboxEvents OutboxEvent[]
  taskDocuments TaskDocument[]

  @@index([owner_id])
  @@index([creator_id])
  @@index([status])
  @@index([record_id])
  @@index([retention_expires_at])
  @@index([disposal_status])
}

model TaskDocument {
  id          String   @id @default(uuid())
  task_id     String
  document_id String
  attached_by String
  attached_at DateTime @default(now())

  document Document @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@unique([task_id, document_id])
  @@index([task_id])
  @@index([document_id])
}

model OutboxEvent {
  id             String   @id @default(uuid())
  document_id    String?
  event_id       String   @unique
  event_type     String
  correlation_id String
  producer       String
  actor_id       String?
  resource_type  String
  resource_id    String
  schema_version Int      @default(1)
  payload        Json
  occurred_at    DateTime
  published_at   DateTime?
  available_at   DateTime @default(now())
  attempts       Int      @default(0)
  last_error     String?
  created_at     DateTime @default(now())

  document Document? @relation(fields: [document_id], references: [id], onDelete: SetNull)

  @@index([published_at, available_at, created_at])
  @@index([document_id])
}

model DocumentVersion {
  id           String   @id @default(uuid())
  document_id  String
  version      Int
  object_key   String
  checksum     String
  signature    String?
  kek_version  Int      @default(1)
  encrypted_dek String
  file_size    Int
  mime_type    String
  created_by   String
  created_at   DateTime @default(now())

  document Document @relation(fields: [document_id], references: [id], onDelete: Cascade)

  @@unique([document_id, version])
  @@index([document_id])
}

model Record {
  id          String    @id @default(uuid())
  title       String
  description String?
  status      String    @default("DRAFT")
  creator_id  String
  sealed_at   DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  entries     RecordEntry[]
  packages    TransferPackage[]

  @@index([creator_id])
  @@index([status])
}

model RecordEntry {
  id                  String   @id @default(uuid())
  record_id           String
  document_id         String
  document_version_id String
  added_at            DateTime @default(now())

  record Record @relation(fields: [record_id], references: [id], onDelete: Cascade)

  @@unique([record_id, document_id, document_version_id])
}

model TransferPackage {
  id                String    @id @default(uuid())
  record_id         String
  status            String    @default("DRAFT")
  submitter_id      String?
  archivist_id      String?
  manifest          Json?
  metadata          Json?
  checksums         Json?
  package_checksum  String?
  signature         String?
  rejection_reason  String?
  receipt           Json?
  audit_references  Json?
  submitted_at      DateTime?
  received_at       DateTime?
  decided_at        DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  record Record @relation(fields: [record_id], references: [id])

  @@index([record_id])
  @@index([status])
  @@index([submitter_id])
}

model DownloadTicket {
  id           String   @id @default(uuid())
  document_id  String
  task_id      String?
  version      Int
  actor_id     String
  object_key   String
  expires_at   DateTime
  used_at      DateTime?
  created_at   DateTime @default(now())

  @@index([document_id])
  @@index([task_id])
  @@index([actor_id])
  @@index([expires_at])
}

model PreviewSession {
  id                  String    @id @default(uuid())
  document_id         String
  task_id             String?
  version             Int
  actor_id            String
  security_preview_id String
  page_count          Int
  mime_type           String
  expires_at          DateTime
  revoked_at          DateTime?
  last_used_at        DateTime?
  page_requests       Int       @default(0)
  created_at          DateTime  @default(now())

  @@index([document_id])
  @@index([actor_id])
  @@index([expires_at])
  @@index([security_preview_id])
}

model DisposalApproval {
  id              String    @id @default(uuid())
  document_id     String
  approver_id     String
  reason          String
  approved_at     DateTime  @default(now())
  expires_at      DateTime?

  @@index([document_id])
  @@index([approver_id])
}

model RetentionHold {
  id          String    @id @default(uuid())
  document_id String
  reason      String
  placed_by   String
  placed_at   DateTime  @default(now())
  released_at DateTime?

  @@index([document_id])
  @@index([released_at])
}

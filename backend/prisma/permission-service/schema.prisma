generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@prisma/client-permission"
}

datasource db {
  provider = "postgresql"
  url      = env("PERMISSION_DATABASE_URL")
}

model Grant {
  id                   String    @id @default(uuid())
  grantor_id           String
  actor_id             String
  resource_type        String
  resource_id          String
  permissions          String[]
  task_id              String
  parent_grant_id      String?
  expires_at           DateTime
  effective_expires_at DateTime
  status               String    @default("ACTIVE")
  revoked_at           DateTime?
  revocation_reason    String?
  created_at           DateTime  @default(now())

  parent   Grant?  @relation("Delegation", fields: [parent_grant_id], references: [id])
  children Grant[] @relation("Delegation")

  @@index([actor_id])
  @@index([resource_id])
  @@index([task_id])
  @@index([parent_grant_id])
  @@index([effective_expires_at])
  @@index([status])
}

model ConsumedEvent {
  id           String   @id @default(uuid())
  event_id     String   @unique
  event_type   String
  resource_id  String
  processed_at DateTime @default(now())
  metadata     Json?

  @@index([event_type, processed_at])
}

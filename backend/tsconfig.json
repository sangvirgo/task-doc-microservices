{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@c17/contracts": ["libs/contracts/src"],
      "@c17/contracts/*": ["libs/contracts/src/*"],
      "@c17/auth-context": ["libs/auth-context/src"],
      "@c17/auth-context/*": ["libs/auth-context/src/*"],
      "@c17/config": ["libs/config/src"],
      "@c17/config/*": ["libs/config/src/*"],
      "@c17/email": ["libs/email/src"],
      "@c17/email/*": ["libs/email/src/*"],
      "@c17/messaging": ["libs/messaging/src"],
      "@c17/messaging/*": ["libs/messaging/src/*"],
      "@c17/observability": ["libs/observability/src"],
      "@c17/observability/*": ["libs/observability/src/*"],
      "@c17/testing": ["libs/testing/src"],
      "@c17/testing/*": ["libs/testing/src/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@prisma/client-document-security"
}

datasource db {
  provider = "postgresql"
  url      = env("DOCUMENT_SECURITY_DATABASE_URL")
}

model EncryptionRecord {
  id            String   @id @default(uuid())
  document_id   String
  version       Int
  object_key    String
  checksum      String
  signature     String?
  kek_version   Int      @default(1)
  encrypted_dek String
  iv            String
  auth_tag      String
  file_size     Int
  mime_type     String
  scan_status   String   @default("PENDING")
  scan_result   String?
  created_at    DateTime @default(now())

  @@unique([document_id, version])
  @@index([document_id])
  @@index([object_key])
}

model KekVersion {
  id         Int      @id @default(autoincrement())
  active     Boolean  @default(true)
  created_at DateTime @default(now())
}

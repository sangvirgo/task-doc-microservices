{
  "name": "c17-task-document-platform",
  "version": "0.1.0",
  "description": "Task Assignment and Secure Digital Document Sharing Platform for Organizations",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/build-all.mjs",
    "build:app": "nest build",
    "start:dev": "nest start --watch",
    "smoke": "node scripts/health-smoke.mjs",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "format:check": "prettier --check \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint": "eslint \"{apps,libs}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.config.ts --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "11",
    "@nestjs/microservices": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/terminus": "11.1.1",
    "@prisma/client": "6",
    "amqp-connection-manager": "4.1.15",
    "amqplib": "0.10.9",
    "bcryptjs": "2",
    "ioredis": "5",
    "pino": "9.14.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "11.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.28",
    "@types/amqplib": "0.10.8",
    "@types/bcryptjs": "3.0.0",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "24.13.3",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "jest": "29.7.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "prisma": "6",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  }
}
